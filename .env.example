# Postgres bağlantısı (Supabase: Project Settings > Database > Connection string, "Session pooler" önerilir)
DATABASE_URL=postgres://postgres:...@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Uygulamanın herkese açık adresi (bağlantılar ve QR kodları bununla üretilir)
APP_URL=https://vettore.example.com
# En az 32 karakter rastgele değer:  openssl rand -base64 48
SESSION_SECRET=
# IBAN ve T.C. kimlik no şifreleme anahtarı, 32 bayt base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# E-posta: 'log' (varsayılan, hiçbir e-posta gönderilmez) veya 'resend'
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Test/ön izleme ortamında tüm e-postaları tek adrese yönlendirmek için
EMAIL_REDIRECT_TO=
