{
  "$comment": "Kaynak: Musteri_Bilgi_Formu.docx (VETTOREHOME). Etiketler orijinal belgeden birebir alınmıştır. 'audience': customer = müşteri doldurur, internal = yalnızca Vettore yetkilisi. 'added': true = orijinalde olmayan, ülke esnekliği veya KVKK/GDPR için eklenen alan.",
  "formId": "vettore-musteri-bilgi-formu",
  "version": "1.0.0",
  "tenant": "vettore",
  "title": "MÜŞTERİ BİLGİ FORMU",
  "brand": {
    "wordmark": ["VETTORE", "HOME"],
    "colors": { "gold": "#9D843F", "cream": "#F3EDE2" },
    "note": "Kaynak belgede logo görseli yok; yalnızca VETTOREHOME yazı markası var. Resmi logo Vettore'den teyit edilmeli."
  },
  "header": [
    { "key": "form_date", "label": "TARİH", "type": "date", "audience": "system", "note": "Gönderim tarihi otomatik" },
    { "key": "sales_rep", "label": "SATIŞ TEMSİLCİSİ", "type": "text", "audience": "internal", "note": "Bağlantı oluşturulurken temsilci seçilir; müşteriye adı gösterilebilir" }
  ],
  "sections": [
    {
      "no": 1, "key": "company", "title": "FİRMA GENEL BİLGİLERİ", "audience": "customer",
      "fields": [
        { "key": "country", "label": "ÜLKE", "type": "select", "options": ["TR", "DE", "OTHER"], "required": true, "added": true },
        { "key": "trade_name", "label": "TİCARİ ÜNVANI", "type": "text", "required": true },
        { "key": "billing_address", "label": "FATURA ADRESİ", "type": "address", "required": true },
        { "key": "hq_address", "label": "MERKEZ ADRESİ", "type": "address", "required": false, "sameAsOption": "billing_address" },
        { "key": "sector", "label": "SEKTÖR / FAALİYET KONUSU", "type": "text", "required": true },
        { "key": "activity_description", "label": "FAALİYET ALANI (AÇIKLAMA)", "type": "textarea", "required": false },
        { "key": "founded_year", "label": "KURULUŞ YILI", "type": "year", "required": false },
        { "key": "employee_count", "label": "ÇALIŞAN SAYISI", "type": "integer", "required": false },
        { "key": "capital", "label": "SERMAYE BİLGİSİ", "type": "money", "required": false }
      ],
      "groups": [
        {
          "key": "registry_tax", "title": "TİCARET SİCİL VE VERGİ BİLGİLERİ",
          "fields": [
            { "key": "tax_office", "label": "VERGİ DAİRESİ", "type": "text", "required": true, "showIf": { "country": "TR" } },
            { "key": "tax_number", "label": "VERGİ NO", "type": "text", "required": true, "validate": "tr_vkn_or_country", "note": "TR: 10 haneli VKN; DE: Steuernummer" },
            { "key": "vat_id", "label": "USt-IdNr. / VAT ID", "type": "text", "required": false, "showIf": { "country": ["DE", "OTHER"] }, "validate": "eu_vat", "added": true },
            { "key": "trade_registry_no", "label": "TİCARET SİCİL NO", "type": "text", "required": false, "note": "DE: Handelsregister-Nr. (HRB/HRA)" },
            { "key": "registry_court", "label": "Registergericht (Amtsgericht)", "type": "text", "required": false, "showIf": { "country": "DE" }, "added": true },
            { "key": "mersis_no", "label": "MERSİS NO", "type": "text", "required": false, "showIf": { "country": "TR" }, "validate": "digits16" },
            { "key": "chamber", "label": "TİCARET ODASI", "type": "text", "required": false, "note": "DE: IHK" },
            { "key": "chamber_registry_no", "label": "ODA SİCİL NO", "type": "text", "required": false },
            { "key": "kep", "label": "KEP (KAYITLI E-POSTA)", "type": "email", "required": false, "showIf": { "country": "TR" } },
            { "key": "website", "label": "WEB SİTESİ", "type": "url", "required": false }
          ]
        },
        {
          "key": "einvoice", "title": "E-FATURA / E-ARŞİV BİLGİLERİ", "showIf": { "country": "TR" },
          "fields": [
            { "key": "einvoice_status", "label": "E-FATURA / E-ARŞİV DURUMU", "type": "multicheck", "options": ["E-FATURA MÜKELLEFİ", "E-ARŞİV MÜKELLEFİ", "E-İRSALİYE KULLANICISI"], "required": false },
            { "key": "einvoice_email", "label": "E-FATURA / E-ARŞİV GÖNDERİM E-POSTASI", "type": "email", "required": false }
          ]
        }
      ]
    },
    {
      "no": 2, "key": "contacts", "title": "YETKİLİ VE İLETİŞİM BİLGİLERİ", "audience": "customer",
      "repeatTemplate": {
        "fields": [
          { "key": "full_name", "label": "ADI SOYADI", "type": "text" },
          { "key": "position", "label": "POZİSYONU", "type": "text" },
          { "key": "direct_phone", "label": "DİREKT TELEFON", "type": "phone" },
          { "key": "mobile_phone", "label": "CEP TELEFON", "type": "phone" },
          { "key": "email", "label": "E-POSTA", "type": "email" }
        ]
      },
      "groups": [
        { "key": "legal_rep", "title": "TEMSİLE YETKİLİ KİŞİ", "required": ["full_name", "position", "mobile_phone", "email"] },
        { "key": "finance_contact", "title": "MUHASEBE / FİNANS YETKİLİSİ", "required": ["full_name", "email"] },
        { "key": "purchasing_contact", "title": "SİPARİŞ / SATIN ALMA YETKİLİSİ", "required": [] }
      ]
    },
    {
      "no": 3, "key": "delivery", "title": "ADRES VE TESLİMAT BİLGİLERİ", "audience": "customer",
      "fields": [
        { "key": "delivery_address", "label": "İŞYERİ / TESLİMAT ADRESİ", "type": "address", "required": true, "sameAsOption": "billing_address" },
        { "key": "delivery_hours", "label": "TESLİMAT SAATLERİ", "type": "text", "required": false },
        { "key": "delivery_notes", "label": "ÖZEL TESLİMAT NOTLARI", "type": "textarea", "required": false }
      ],
      "groups": [
        {
          "key": "delivery_contact", "title": "TESLİMAT ALMA YETKİLİSİ",
          "fields": [
            { "key": "full_name", "label": "ADI SOYADI", "type": "text", "required": false },
            { "key": "position", "label": "POZİSYON", "type": "text", "required": false },
            { "key": "phone", "label": "TELEFON", "type": "phone", "required": false },
            { "key": "mobile_phone", "label": "CEP TELEFONU", "type": "phone", "required": false }
          ]
        }
      ]
    },
    {
      "no": 4, "key": "finance", "title": "FİNANS VE ÖDEME BİLGİLERİ", "audience": "customer",
      "fields": [
        { "key": "currency", "label": "PARA BİRİMİ", "type": "select", "options": ["TRY", "EUR", "USD"], "default": "TRY", "required": true, "added": true, "note": "Orijinal formda tutarlar TL; DE müşterileri için EUR" },
        { "key": "requested_term_days", "label": "ÇALIŞMA TALEP EDİLEN VADE", "type": "integer", "unit": "GÜN", "required": false },
        { "key": "requested_credit_limit", "label": "TALEP EDİLEN KREDİ LİMİTİ", "type": "money", "required": false },
        { "key": "avg_monthly_purchase", "label": "ORTALAMA AYLIK SATIN ALMA HACMİ", "type": "money", "required": false },
        { "key": "annual_purchase_estimate", "label": "YILLIK TAHMİNİ SATIN ALMA HACMİ", "type": "money", "required": false },
        { "key": "payment_methods", "label": "ÖDEME ŞEKLİ TERCİHİ", "type": "multicheck", "options": ["HAVALE", "EFT", "ÇEK", "NAKİT", "KREDİ KARTI"], "required": true },
        { "key": "payment_day", "label": "ÖDEME GÜNÜ TERCİHİ", "type": "choice_with_input", "options": [ { "value": "DAY_OF_MONTH", "label": "AYIN ___ GÜNÜ", "input": "integer:1-31" }, { "value": "TERM_END", "label": "VADE SONU" }, { "value": "OTHER", "label": "DİĞER", "input": "text" } ], "required": false }
      ],
      "groups": [
        {
          "key": "bank_accounts", "title": "BANKA BİLGİLERİ (ÖDEMELER İÇİN)", "repeat": { "min": 0, "max": 3 }, "sensitive": true,
          "fields": [
            { "key": "bank_name", "label": "BANKA ADI", "type": "text" },
            { "key": "branch", "label": "ŞUBE ADI", "type": "text" },
            { "key": "iban", "label": "IBAN", "type": "iban", "validate": "iban_checksum", "encrypt": true },
            { "key": "account_holder", "label": "HESAP SAHİBİ", "type": "text" }
          ]
        }
      ]
    },
    {
      "no": 5, "key": "ownership", "title": "FİRMA ORTAKLIK / SAHİPLİK BİLGİLERİ", "audience": "customer", "sensitive": true,
      "groups": [
        {
          "key": "partners", "repeat": { "min": 0, "max": 6 },
          "fields": [
            { "key": "full_name", "label": "ADI SOYADI", "type": "text" },
            { "key": "national_id", "label": "T.C. KİMLİK NO", "type": "text", "validate": "tckn_checksum", "encrypt": true, "maskInLists": true, "required": false, "showIf": { "country": "TR" }, "note": "Veri minimizasyonu: Vettore'nin bu alana gerçekten ihtiyacı teyit edilmeli; zorunlu yapılmadı." },
            { "key": "role", "label": "POZİSYONU / GÖREVİ", "type": "text" },
            { "key": "share_pct", "label": "HİSSE ORANI (%)", "type": "percent", "validate": "0-100; toplam <= 100" }
          ]
        }
      ]
    },
    {
      "no": 6, "key": "commercial", "title": "TİCARİ BİLGİLER", "audience": "customer",
      "fields": [
        { "key": "other_suppliers", "label": "ÇALIŞTIĞINIZ DİĞER FİRMALAR (EN YÜKSEK CİROLU)", "type": "list", "max": 4, "required": false },
        { "key": "references", "label": "REFERANSLAR", "type": "list", "max": 4, "required": false }
      ]
    },
    {
      "no": 7, "key": "preferences", "title": "FATURA TESLİMATI VE İLETİŞİM TERCİHLERİ", "audience": "customer",
      "fields": [
        { "key": "invoice_delivery", "label": "FATURA TESLİMATI", "type": "multicheck", "options": ["E-POSTA", "E-FATURA", "E-ARŞİV", "KAĞIT"], "required": true },
        { "key": "invoice_email", "label": "FATURA GÖNDERİM E-POSTASI", "type": "email", "required": false, "requiredIf": { "invoice_delivery": "E-POSTA" } },
        { "key": "marketing_consent", "label": "SMS / E-POSTA İLE TİCARİ İLETİŞİM İZNİ", "type": "radio", "options": ["EVET", "HAYIR"], "required": true, "note": "Ayrı ve isteğe bağlı izin; HAYIR seçimi gönderimi engellemez." },
        { "key": "privacy_notice_ack", "label": "Aydınlatma metnini okudum", "type": "checkbox", "required": true, "added": true, "note": "KVKK md.10 / GDPR md.13 aydınlatma: açık rızadan ayrı tutulmalı. Metin Vettore veri sorumlusundan alınacak." },
        { "key": "kvkk_consent", "label": "KVKK AYDINLATMA METNİ VE AÇIK RIZA", "type": "radio", "options": ["KABUL EDİYORUM", "KABUL ETMİYORUM"], "required": true, "text": "6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında, kişisel verilerimin ilgili kanun ve mevzuata uygun şekilde işlenmesine, saklanmasına ve gerekli olması halinde üçüncü kişilerle paylaşılmasına açık rıza veriyorum.", "note": "Orijinal metin korunmuştur. Hukuki risk: açık rıza hizmet şartına bağlanamaz; KABUL ETMİYORUM seçimi gönderimi engellemez. Metnin Vettore hukuk danışmanınca gözden geçirilmesi önerilir." }
      ]
    },
    {
      "no": 8, "key": "sales_evaluation", "title": "SATIŞ TEMSİLCİSİ DEĞERLENDİRMESİ", "audience": "internal",
      "fields": [
        { "key": "customer_potential", "label": "MÜŞTERİ POTANSİYELİ", "type": "radio", "options": ["DÜŞÜK", "ORTA", "YÜKSEK"] },
        { "key": "risk_assessment", "label": "RİSK DEĞERLENDİRMESİ", "type": "radio", "options": ["DÜŞÜK", "ORTA", "YÜKSEK"] },
        { "key": "suggested_term_days", "label": "ÖNERİLEN VADE", "type": "integer", "unit": "GÜN" },
        { "key": "suggested_credit_limit", "label": "ÖNERİLEN KREDİ LİMİTİ", "type": "money" },
        { "key": "estimated_annual_revenue", "label": "TAHMİNİ YILLIK CİRO", "type": "money" },
        { "key": "notes", "label": "ÖZEL NOTLAR", "type": "textarea" }
      ]
    },
    {
      "no": 9, "key": "approval", "title": "ONAY BİLGİLERİ",
      "groups": [
        {
          "key": "company_signatory", "title": "FİRMA YETKİLİSİ", "audience": "customer",
          "fields": [
            { "key": "full_name", "label": "ADI SOYADI", "type": "text", "required": true },
            { "key": "title", "label": "ÜNVANI", "type": "text", "required": true },
            { "key": "date", "label": "TARİH", "type": "date", "audience": "system" },
            { "key": "declaration", "label": "Bu formdaki bilgilerin doğruluğunu kabul ve beyan ederim.", "type": "checkbox", "required": true },
            { "key": "signature", "label": "İMZA", "type": "signature", "required": false, "note": "Dijital onay = beyan kutusu + ad/ünvan + zaman damgası + IP. Islak imza/kaşe PDF çıktısında boş alan olarak korunur." },
            { "key": "stamp", "label": "FİRMA KAŞESİ", "type": "print_only" }
          ]
        },
        {
          "key": "sales_rep_approval", "title": "SATIŞ TEMSİLCİSİ ONAYI", "audience": "internal",
          "fields": [
            { "key": "full_name", "label": "ADI SOYADI", "type": "text" },
            { "key": "date", "label": "TARİH", "type": "date" },
            { "key": "signature", "label": "İMZA", "type": "print_only" }
          ]
        },
        {
          "key": "internal_use", "title": "İÇ KULLANIM ALANI", "audience": "internal",
          "fields": [
            { "key": "customer_code", "label": "MÜŞTERİ KODU", "type": "text" },
            { "key": "registered_at", "label": "KAYIT TARİHİ", "type": "date" },
            { "key": "registered_by", "label": "KAYDI YAPAN", "type": "text" },
            { "key": "approval_status", "label": "ONAY DURUMU", "type": "radio", "options": ["ONAYLANDI", "REDDEDİLDİ"] },
            { "key": "approval_date", "label": "ONAY TARİHİ", "type": "date" }
          ]
        }
      ]
    }
  ]
}
